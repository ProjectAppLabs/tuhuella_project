{
  "name": "tu-huella",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--no-deprecation jest",
    "test:watch": "NODE_OPTIONS=--no-deprecation jest --watch",
    "test:ci": "NODE_OPTIONS=--no-deprecation jest --ci",
    "test:coverage": "NODE_OPTIONS=--no-deprecation jest --coverage && node scripts/coverage-summary.cjs",
    "e2e:clean": "rm -rf playwright-report test-results blob-report",
    "e2e:modules": "npm run e2e:clean && node ./scripts/e2e-modules.cjs",
    "e2e:module": "npm run e2e:clean && node ./scripts/e2e-module.cjs",
    "e2e:coverage": "npm run e2e:clean && npm run test:e2e",
    "e2e:coverage:module": "npm run e2e:clean && node ./scripts/e2e-coverage-module.cjs",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --project=\"Desktop Chrome\"",
    "e2e:mobile": "playwright test --project=\"Mobile Chrome\"",
    "e2e:tablet": "playwright test --project=\"Tablet\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "check:e2e-flow-sync": "node scripts/check-flow-definitions-sync.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-oauth/google": "^0.13.5",
    "@types/react-google-recaptcha": "^2.1.9",
    "axios": "^1.20.0",
    "dompurify": "3.4.16",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.8",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-google-recaptcha": "^3.1.0",
    "swiper": "^11.2.10",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-playwright": "^2.11.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^10.2.4",
    "flatted": "^3.4.0"
  }
}
